# CareNest root Docker Compose environment example.
# Copy to .env for local/staging Docker runs and replace every placeholder value.
# Never commit .env, .env.staging, .env.prod, or real secrets.

# Spring profile used by the backend container.
SPRING_PROFILES_ACTIVE=prod

# Host port exposed by the backend container.
BACKEND_PORT=8080

# PostgreSQL container settings.
POSTGRES_DB=carenest_db
POSTGRES_USER=carenest_user
POSTGRES_PASSWORD=change-me-postgres-password

# Redis container password.
REDIS_PASSWORD=change-me-redis-password

# JWT signing secret. Use a long random value in real environments.
JWT_SECRET=change-me-long-random-jwt-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# SMTP credentials. Leave empty only if mail flows are not being tested.
MAIL_USERNAME=
MAIL_PASSWORD=

# Uploaded media settings.
MEDIA_UPLOAD_DIR=uploads/media
MEDIA_MAX_IMAGE_SIZE_BYTES=5242880

# AI/OCR phase-final only. Leave empty for current MVP unless enabling real AI.
GEMINI_API_KEY=
APP_FEATURE_AI_CHAT_ENABLED=false
APP_FEATURE_OCR_ENABLED=false

# Optional maintenance scripts only. Leave empty unless running local SQL helper scripts.
CARENEST_DATABASE_DSN=
