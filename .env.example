# ═══════════════════════════════════════════════════════════════
# CareNest - Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# HƯỚNG DẪN:
# 1. Copy file này thành .env.staging hoặc .env.prod
# 2. Điền đầy đủ giá trị cho từng biến
# 3. TUYỆT ĐỐI KHÔNG commit file .env* thật lên Git!
# ═══════════════════════════════════════════════════════════════

# ── Spring Profile ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=carenest_db
POSTGRES_USER=carenest_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ── JWT Security ────────────────────────────────────────────────
# Phải là chuỗi ngẫu nhiên, đủ dài (>= 256-bit / 32 ký tự)
# Tạo bằng: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_256_BITS

# ── AI / Gemini ─────────────────────────────────────────────────
# Lấy từ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY

# ── Mail SMTP ───────────────────────────────────────────────────
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── Backend Port ────────────────────────────────────────────────
BACKEND_PORT=8080
