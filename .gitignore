# ═══════════════════════════════════════════════
# CareNest Monorepo - .gitignore
# ═══════════════════════════════════════════════

# ── IDE (Android Studio / IntelliJ / VS Code) ──
.idea/
*.iml
.vscode/

# ── Android Build ───────────────────────────────
.gradle/
**/build/
/captures/
.externalNativeBuild/
.cxx/
local.properties

# ── Backend (Spring Boot / Maven) ───────────────
backend/target/
backend/*.log
backend/.mvn/wrapper/maven-wrapper.jar

# ── OS ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
