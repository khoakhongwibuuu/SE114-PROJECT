<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cblue"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_activity_medicine"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_centerInParent="true"/>
                <ImageButton
                    android:id="@+id/btnHome"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_home"
                    android:contentDescription="Trang chủ"
                    app:tint="@color/blue" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Chưa có thuốc nào"
                    android:textColor="#888"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <TableLayout
                android:id="@+id/tableMedicine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1">
                <TableRow>
                    <TextView
                        android:text="@string/TableText_Name"
                        android:background="@drawable/header_cell_bg"
                        android:padding="12dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                    <TextView
                        android:text="@string/TableText_Count"
                        android:background="@drawable/header_cell_bg"
                        android:padding="12dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                    <TextView
                        android:text="@string/TableText_Expired"
                        android:background="@drawable/header_cell_bg"
                        android:padding="12dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInputNew"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="16dp"
                android:text="@string/btnThemThuoc"
                app:layout_constraintTop_toBottomOf="@id/tableMedicine"
                app:backgroundTint="@color/blue" />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/txtReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_activity_alarm"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Chưa có hẹn giờ nào"
                    android:textColor="#888"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <TableLayout
                android:id="@+id/tableReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1">
            <TableRow>
                <TextView
                    android:text="@string/TableText_Name"
                    android:background="@drawable/header_cell_bg"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
                <TextView
                    android:text="@string/TableText_Time"
                    android:background="@drawable/header_cell_bg"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </TableRow>
            </TableLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInputNew"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="16dp"
                android:text="@string/btnThemThoiGian"
                app:layout_constraintTop_toBottomOf="@id/tableMedicine"
                app:backgroundTint="@color/blue" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>